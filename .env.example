# ---- AccessiPath environment ----
# Copy to `.env` and fill in for local development.

# Backend
PORT=4000
NODE_ENV=development

# PostgreSQL with PostGIS (optional locally; memory mode is used when empty).
# Example: postgres://user:password@host:5432/accessipath
DATABASE_URL=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public routing endpoint (free OSRM public demo; swap for GraphHopper/ORS key later).
OSRM_URL=https://router.project-osrm.org

# Public geocoding endpoint (OpenStreetMap Nominatim - be polite: 1 req/s).
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Overpass API for OSM data imports.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Frontend
# VITE_API_URL=  # leave empty in dev; set to backend URL on Render