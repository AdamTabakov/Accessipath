# ---- AccessiPath environment ----
# Copy to `.env` and fill in for local development.
# In production, set ALL variables via the hosting platform (Render, Docker, CI).
# Never commit real secrets; use a .env that is gitignored.

# Backend
PORT=4000
NODE_ENV=development

# PostgreSQL with PostGIS (optional locally; memory mode is used when empty).
# Example: postgres://user:password@host:5432/accessipath
DATABASE_URL=

# Comma-separated list of allowed frontend origins.
# Must be set to your deployed frontend URL in production, e.g.
# CORS_ORIGINS=https://your-app.onrender.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory for uploaded report photos (relative to backend/).
UPLOAD_DIR=uploads

# Public routing endpoint (free OSRM public demo; swap for GraphHopper/ORS key later).
OSRM_URL=https://router.project-osrm.org

# Public geocoding endpoint (OpenStreetMap Nominatim - be polite: 1 req/s).
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Overpass API for OSM data imports.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Auth & email verification
# APP_URL is the frontend origin (used in verification emails).
APP_URL=http://localhost:5173
# JWT secret - MUST be set to a strong random value in production.
# Never use the dev default in production; set via JWT_SECRET env var.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# How long a 6-digit verification code stays valid (minutes).
VERIFICATION_CODE_TTL_MINUTES=15
# Resend API key for sending verification emails.
# In development you can leave empty (code logged); in production set a key.
RESEND_API_KEY=
RESEND_FROM=AccessiPath <onboarding@resend.dev>

# Frontend
# VITE_API_URL=  # leave empty in dev; set to backend URL on Render