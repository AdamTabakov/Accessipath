# ---- AccessiPath environment ----
# Copy to `.env` and fill in for local development.

# Backend
PORT=4000
NODE_ENV=development

# PostgreSQL with PostGIS (optional locally; memory mode is used when empty).
# Example: postgres://user:password@host:5432/accessipath
DATABASE_URL=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public routing endpoint (free OSRM public demo; swap for GraphHopper/ORS key later).
OSRM_URL=https://router.project-osrm.org

# Public geocoding endpoint (OpenStreetMap Nominatim - be polite: 1 req/s).
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Overpass API for OSM data imports.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Auth & email verification
# APP_URL is the frontend origin (used in verification emails).
APP_URL=http://localhost:5173
# JWT secret - set a strong random value in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# How long a 6-digit verification code stays valid (minutes).
VERIFICATION_CODE_TTL_MINUTES=15
# Resend API key for sending verification emails. When empty, the dev
# fallback logs the code to the console and returns it to the client
# (never in production - RESEND_API_KEY must be set there).
RESEND_API_KEY=
RESEND_FROM=AccessiPath <onboarding@resend.dev>

# Frontend
# VITE_API_URL=  # leave empty in dev; set to backend URL on Render