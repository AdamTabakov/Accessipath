{
  "name": "accessipath",
  "version": "1.0.0",
  "private": true,
  "description": "Accessibility-first navigation — a Google Maps for people with mobility needs.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "node scripts/backend-python.mjs -m uvicorn app.main:app --reload --port 4000",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start:backend": "node scripts/backend-python.mjs -m uvicorn app.main:app --host 0.0.0.0 --port 4000",
    "test:backend": "node scripts/backend-python.mjs -m pytest -q",
    "typecheck": "npm run typecheck --workspace frontend",
    "import:osm": "node scripts/backend-python.mjs scripts/import_osm.py --update"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}